# Frontend - Variables de entorno (Vite) - ejemplo para .env.local
# Copia a .env.local para desarrollo local:
#   copy .env.local.example .env.local   (Windows)  /  cp .env.local.example .env.local  (Linux/Mac)
#
# Si NO existe ningun .env / .env.local, el frontend usa por defecto
# https://openpaw.alwaysdata.net/api  (ver src/constants.js -> API_BASE_URL fallback).
# En produccion (Vercel) la URL se inyecta via variables de entorno del hosting.

VITE_API_BASE_URL=http://localhost:5000/api

# Opcionales
# VITE_GOOGLE_CLIENT_ID=502526650421-o7vf4m2spjq05k8g6sbpaklkr9pb5fr9.apps.googleusercontent.com
# VITE_FACEBOOK_APP_ID=2470437836755419
