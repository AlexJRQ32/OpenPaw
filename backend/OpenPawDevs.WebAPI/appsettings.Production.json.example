{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "SET_VIA_ENVIRONMENT_VARIABLE__ConnectionStrings__DefaultConnection"
  },
  "Jwt": {
    "Key": "SET_VIA_ENVIRONMENT_VARIABLE__Jwt__Key",
    "Issuer": "OpenPawDevs",
    "Audience": "OpenPawDevsApp",
    "ExpiryMinutes": "60"
  }
}
