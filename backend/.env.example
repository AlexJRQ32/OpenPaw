# Backend - Variables de entorno (ASP.NET Core)
# Copia este archivo a .env o configura via User Secrets / hosting env vars.
# ASP.NET Core mapea automaticamente env vars con __ a : (ej: Jwt__Key -> Jwt:Key).
# NUNCA commitear valores reales. Este archivo es plantilla con placeholders.
#
# Uso local (Development):
#   dotnet user-secrets init --project backend/OpenPawDevs.WebAPI
#   dotnet user-secrets set "Jwt:Key" "tu_clave_32_chars_min" --project backend/OpenPawDevs.WebAPI
#   dotnet user-secrets set "Facebook:AppSecret" "tu_app_secret" --project backend/OpenPawDevs.WebAPI
#   dotnet user-secrets set "ConnectionStrings:DefaultConnection" "Server=..." --project backend/OpenPawDevs.WebAPI
# O exportar env vars antes de dotnet run:
#   $env:Jwt__Key="tu_clave_32_chars_min"        # PowerShell
#   $env:Facebook__AppSecret="tu_secret"
#   $env:ConnectionStrings__DefaultConnection="Server=..."
#
# Generar Jwt__Key seguro (32+ chars):
#   openssl rand -base64 32
#   # o PowerShell: [Convert]::ToBase64String((1..32 | % { Get-Random -Max 256 }))

# Base de datos — local dev (Trusted_Connection) o produccion (Somee/Azure)
ConnectionStrings__DefaultConnection=Server=localhost;Database=OpenPawDevs;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true
# Ejemplo produccion (reemplazar y configurar solo en hosting, NO en repo):
# ConnectionStrings__DefaultConnection=Server=tu_servidor.mssql.somee.com;Database=tu_db;User ID=tu_user;Password=tu_password;TrustServerCertificate=True;

# JWT — OBLIGATORIO (min 32 chars, rotar si estuvo en plaintext)
Jwt__Key=REPLACE_WITH_ENV_VAR__Jwt__Key_GENERATE_32_CHARS_MIN
Jwt__Issuer=OpenPawDevs
Jwt__Audience=OpenPawDevsApp
Jwt__ExpiryMinutes=60

# Facebook OAuth — AppId es publico, AppSecret es secreto
Facebook__AppId=2470437836755419
Facebook__AppSecret=REPLACE_WITH_ENV_VAR__Facebook__AppSecret

# Opcional
DataProtection__KeysPath=.aspnet-data-protection-keys
ASPNETCORE_ENVIRONMENT=Development
